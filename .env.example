# ==============================================================================
# SENA ACADEMIC ENGINE - GOOGLE DRIVE INGESTION (.env)
# ==============================================================================
# Obtén estas credenciales en Google Cloud Console:
# 1. Habilita 'Google Drive API v3'
# 2. Crea credenciales OAuth 2.0 (Tipo: Aplicación de escritorio / Desktop app)
# ==============================================================================

# ID de Cliente y Clave Secreta de Google Cloud OAuth
GOOGLE_CLIENT_ID="TU_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-TU_CLIENT_SECRET"

# ID de la carpeta raíz de las clases (ej. carpeta 'SENA' en Drive)
# Se puede configurar automáticamente ejecutando: bash Academic-Engine/scripts/ingest-drive-video.sh --setup
GOOGLE_DRIVE_FOLDER_ID=""

# Token de refresco (se autogenera y guarda automáticamente en el primer login)
GOOGLE_REFRESH_TOKEN=""

# Configuración de Whisper Local (whisper-cpp)
WHISPER_MODEL="ggml-large-v3-turbo.bin"
WHISPER_LANGUAGE="es"
